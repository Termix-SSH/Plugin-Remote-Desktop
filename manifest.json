{
  "id": "remote-desktop",
  "name": "Remote Desktop",
  "version": "1.3.0",
  "description": "RDP, VNC, Apple Remote Desktop and Telnet sessions in your browser, with clipboard, file transfer, sharing and recording.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Remote-Desktop",
  "docs": "https://docs.termix.site/plugins/remote-desktop",
  "video": "https://www.youtube.com/watch?v=enggttL3hz8",
  "category": "Terminal",
  "icon": "Monitor",
  "features": [
    "RDP, VNC, Apple Remote Desktop and Telnet from any browser, with nothing else to install",
    "Tabs and split screen like any other session",
    "Clipboard sync, audio, printing and file transfer through RDP drives",
    "Jump host support",
    "Session sharing and recording",
    "Open a host in the native Windows Remote Desktop client from the desktop app"
  ],
  "env": [
    {
      "name": "REMOTE_DESKTOP_ENGINE",
      "description": "builtin runs RDP, VNC and Telnet inside Termix. guacd sends them to an external guacd instead. Overrides the Use external guacd setting.",
      "default": "builtin"
    },
    {
      "name": "RDP_DRIVE_PATH",
      "description": "Folder the built-in engine keeps RDP drive files in. Each user gets a folder under it.",
      "default": "/app/data/rdp-drive"
    },
    {
      "name": "GUACD_HOST",
      "description": "Host an external guacd listens on. Only used with Use external guacd. Overrides the guacd URL setting.",
      "default": "localhost"
    },
    {
      "name": "GUACD_PORT",
      "description": "Port an external guacd listens on.",
      "default": "4822"
    },
    {
      "name": "GUACD_URL",
      "description": "An external guacd as host:port, in place of GUACD_HOST and GUACD_PORT."
    },
    {
      "name": "GUACD_TUNNEL_HOST",
      "description": "Address an external guacd uses to reach Termix for hosts behind jump hosts and VNC without a username. In Compose, the Termix container name. In Kubernetes it defaults to the pod IP.",
      "default": "termix"
    },
    {
      "name": "GUACD_RECORDING_PATH",
      "description": "Folder an external guacd writes recordings to, as guacd sees it."
    },
    {
      "name": "GUACD_RECORDING_BACKEND_PATH",
      "description": "Folder Termix keeps remote desktop recordings in. With an external guacd, the same folder as Termix sees it.",
      "default": "/app/data/session_recordings/guacamole"
    },
    {
      "name": "GUACD_DRIVE_PATH",
      "description": "Folder an external guacd keeps RDP drive files in. Each user gets a folder under it.",
      "default": "/drive"
    },
    {
      "name": "GUACAMOLE_ENCRYPTION_KEY",
      "description": "Key that encrypts connection tokens, 64 hex characters. Made for you on each start if not set. Set it when you run more than one Termix server.",
      "secret": true
    }
  ],
  "engine": {
    "termix": ">=26.10.3",
    "api": "^1.5"
  },
  "capabilities": [
    "hosts:read",
    "credentials:read",
    "credentials:use",
    "ssh:connect",
    "network:serve",
    "desktop:local",
    "ui:surface",
    "users:impersonate"
  ],
  "optionalDependencies": {
    "session-recording": "^1.0.0",
    "tunnels": "^1.0.0"
  },
  "provides": [
    {
      "service": "sessions.live",
      "version": "1.0.0",
      "permission": "remote-desktop.sessions",
      "names": ["rdp", "vnc", "ard", "telnet"]
    }
  ],
  "requires": [
    {
      "service": "recordings.writer",
      "versionRange": "^1.1.0",
      "optional": true
    },
    {
      "service": "tunnels.access",
      "versionRange": "^1.0.0",
      "optional": true
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "rdp",
        "titleKey": "hosts.tabRdp",
        "icon": "Monitor",
        "openFrom": ["host-context-menu", "palette"]
      },
      {
        "id": "vnc",
        "titleKey": "hosts.tabVnc",
        "icon": "MousePointerClick",
        "openFrom": ["host-context-menu", "palette"]
      },
      {
        "id": "ard",
        "titleKey": "hosts.tabArd",
        "icon": "ScreenShare",
        "openFrom": ["host-context-menu", "palette"]
      },
      {
        "id": "telnet",
        "titleKey": "hosts.tabTelnet",
        "icon": "Terminal",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "actionSlots": [
      {
        "id": "remote-desktop.toolbar",
        "accepts": ["button"]
      }
    ],
    "protocols": [
      {
        "id": "rdp",
        "credentialFields": [
          {
            "key": "domain"
          }
        ],
        "defaultPort": 3389,
        "hostLoginFallback": ["username", "password"]
      },
      {
        "id": "vnc",
        "defaultPort": 5900,
        "hostLoginFallback": ["password"]
      },
      {
        "id": "ard",
        "defaultPort": 5900,
        "hostLoginFallback": ["username", "password"]
      },
      {
        "id": "telnet",
        "defaultPort": 23,
        "hostLoginFallback": ["password"]
      }
    ],
    "guest": true,
    "permissions": [
      {
        "name": "sessions",
        "titleKey": "permissions.sessions.title",
        "descriptionKey": "permissions.sessions.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "enabled",
          "type": "boolean",
          "labelKey": "settings.admin.enabled.label",
          "descriptionKey": "settings.admin.enabled.description",
          "default": true
        },
        {
          "key": "useGuacd",
          "type": "boolean",
          "labelKey": "settings.admin.useGuacd.label",
          "descriptionKey": "settings.admin.useGuacd.description",
          "requires": "enabled",
          "default": false
        },
        {
          "key": "guacdUrl",
          "type": "string",
          "labelKey": "settings.admin.guacdUrl.label",
          "descriptionKey": "settings.admin.guacdUrl.description",
          "placeholderKey": "settings.admin.guacdUrl.placeholder",
          "requires": "useGuacd",
          "default": ""
        },
        {
          "key": "hostGuacd",
          "type": "json",
          "labelKey": "settings.admin.hostGuacd.label",
          "default": {},
          "hidden": true
        },
        {
          "key": "hostGuacdMigrated",
          "type": "boolean",
          "labelKey": "settings.admin.hostGuacdMigrated.label",
          "default": false,
          "hidden": true
        }
      ],
      "host": {
        "fields": [
          {
            "key": "enableRdp",
            "type": "boolean",
            "labelKey": "settings.host.enableRdp.label",
            "default": false,
            "hidden": true,
            "defaultable": false
          },
          {
            "key": "enableVnc",
            "type": "boolean",
            "labelKey": "settings.host.enableVnc.label",
            "default": false,
            "hidden": true,
            "defaultable": false
          },
          {
            "key": "enableArd",
            "type": "boolean",
            "labelKey": "settings.host.enableArd.label",
            "default": false,
            "hidden": true,
            "defaultable": false
          },
          {
            "key": "enableTelnet",
            "type": "boolean",
            "labelKey": "settings.host.enableTelnet.label",
            "default": false,
            "hidden": true,
            "defaultable": false
          },
          {
            "key": "rdpPort",
            "type": "number",
            "labelKey": "settings.host.rdpPort.label",
            "min": 1,
            "max": 65535,
            "default": 3389,
            "hidden": true,
            "defaultable": false
          },
          {
            "key": "vncPort",
            "type": "number",
            "labelKey": "settings.host.vncPort.label",
            "min": 1,
            "max": 65535,
            "default": 5900,
            "hidden": true,
            "defaultable": false
          },
          {
            "key": "ardPort",
            "type": "number",
            "labelKey": "settings.host.ardPort.label",
            "min": 1,
            "max": 65535,
            "default": 5900,
            "hidden": true,
            "defaultable": false
          },
          {
            "key": "telnetPort",
            "type": "number",
            "labelKey": "settings.host.telnetPort.label",
            "min": 1,
            "max": 65535,
            "default": 23,
            "hidden": true,
            "defaultable": false
          },
          {
            "key": "rdpSecurity",
            "type": "string",
            "labelKey": "settings.host.rdpSecurity.label",
            "default": "",
            "hidden": true
          },
          {
            "key": "rdpIgnoreCert",
            "type": "boolean",
            "labelKey": "settings.host.rdpIgnoreCert.label",
            "default": false,
            "hidden": true
          },
          {
            "key": "guacamoleConfig",
            "type": "json",
            "labelKey": "settings.host.guacamoleConfig.label",
            "default": {},
            "hidden": true,
            "shareRead": "edit",
            "secretKeys": ["gateway-password"],
            "defaultable": false
          },
          {
            "key": "enableToolbar",
            "type": "boolean",
            "labelKey": "settings.host.enableToolbar.label",
            "descriptionKey": "settings.host.enableToolbar.description",
            "default": true,
            "hidden": true
          },
          {
            "key": "toolbarPosition",
            "type": "select",
            "labelKey": "settings.host.toolbarPosition.label",
            "hidden": true,
            "default": "top",
            "options": [
              {
                "value": "top",
                "labelKey": "settings.host.toolbarPosition.top"
              },
              {
                "value": "bottom",
                "labelKey": "settings.host.toolbarPosition.bottom"
              }
            ]
          },
          {
            "key": "toolbarLabels",
            "type": "select",
            "labelKey": "settings.host.toolbarLabels.label",
            "hidden": true,
            "default": "labeled",
            "options": [
              {
                "value": "labeled",
                "labelKey": "settings.host.toolbarLabels.labeled"
              },
              {
                "value": "icons",
                "labelKey": "settings.host.toolbarLabels.icons"
              }
            ]
          },
          {
            "key": "toolbarButtons",
            "type": "json",
            "labelKey": "settings.host.toolbarButtons.label",
            "hidden": true
          },
          {
            "key": "colorDepth",
            "type": "select",
            "labelKey": "settings.user.colorDepth.label",
            "descriptionKey": "settings.user.colorDepth.description",
            "group": "settings.host.displayGroup",
            "options": [
              {
                "value": "inherit",
                "labelKey": "settings.user.inherit"
              },
              {
                "value": "16",
                "labelKey": "settings.user.colorDepth16"
              },
              {
                "value": "24",
                "labelKey": "settings.user.colorDepth24"
              },
              {
                "value": "32",
                "labelKey": "settings.user.colorDepth32"
              }
            ],
            "default": "inherit",
            "personal": true
          },
          {
            "key": "resizeMethod",
            "type": "select",
            "labelKey": "settings.user.resizeMethod.label",
            "descriptionKey": "settings.user.resizeMethod.description",
            "group": "settings.host.displayGroup",
            "options": [
              {
                "value": "inherit",
                "labelKey": "settings.user.inherit"
              },
              {
                "value": "display-update",
                "labelKey": "settings.user.resizeDisplayUpdate"
              },
              {
                "value": "reconnect",
                "labelKey": "settings.user.resizeReconnect"
              }
            ],
            "default": "inherit",
            "personal": true
          },
          {
            "key": "forceLossless",
            "type": "select",
            "labelKey": "settings.user.forceLossless.label",
            "descriptionKey": "settings.user.forceLossless.description",
            "group": "settings.host.displayGroup",
            "options": [
              {
                "value": "inherit",
                "labelKey": "settings.user.inherit"
              },
              {
                "value": "on",
                "labelKey": "settings.user.on"
              },
              {
                "value": "off",
                "labelKey": "settings.user.off"
              }
            ],
            "default": "inherit",
            "personal": true
          },
          {
            "key": "enableWallpaper",
            "type": "select",
            "labelKey": "settings.user.enableWallpaper.label",
            "descriptionKey": "settings.user.enableWallpaper.description",
            "group": "settings.host.displayGroup",
            "options": [
              {
                "value": "inherit",
                "labelKey": "settings.user.inherit"
              },
              {
                "value": "on",
                "labelKey": "settings.user.on"
              },
              {
                "value": "off",
                "labelKey": "settings.user.off"
              }
            ],
            "default": "inherit",
            "personal": true
          },
          {
            "key": "enableFontSmoothing",
            "type": "select",
            "labelKey": "settings.user.enableFontSmoothing.label",
            "descriptionKey": "settings.user.enableFontSmoothing.description",
            "group": "settings.host.displayGroup",
            "options": [
              {
                "value": "inherit",
                "labelKey": "settings.user.inherit"
              },
              {
                "value": "on",
                "labelKey": "settings.user.on"
              },
              {
                "value": "off",
                "labelKey": "settings.user.off"
              }
            ],
            "default": "inherit",
            "personal": true
          },
          {
            "key": "enableDesktopComposition",
            "type": "select",
            "labelKey": "settings.user.enableDesktopComposition.label",
            "descriptionKey": "settings.user.enableDesktopComposition.description",
            "group": "settings.host.displayGroup",
            "options": [
              {
                "value": "inherit",
                "labelKey": "settings.user.inherit"
              },
              {
                "value": "on",
                "labelKey": "settings.user.on"
              },
              {
                "value": "off",
                "labelKey": "settings.user.off"
              }
            ],
            "default": "inherit",
            "personal": true
          },
          {
            "key": "disableAudio",
            "type": "select",
            "labelKey": "settings.user.disableAudio.label",
            "descriptionKey": "settings.user.disableAudio.description",
            "group": "settings.host.displayGroup",
            "options": [
              {
                "value": "inherit",
                "labelKey": "settings.user.inherit"
              },
              {
                "value": "on",
                "labelKey": "settings.user.on"
              },
              {
                "value": "off",
                "labelKey": "settings.user.off"
              }
            ],
            "default": "inherit",
            "personal": true
          },
          {
            "key": "enablePrinting",
            "type": "select",
            "labelKey": "settings.user.enablePrinting.label",
            "descriptionKey": "settings.user.enablePrinting.description",
            "group": "settings.host.displayGroup",
            "options": [
              {
                "value": "inherit",
                "labelKey": "settings.user.inherit"
              },
              {
                "value": "on",
                "labelKey": "settings.user.on"
              },
              {
                "value": "off",
                "labelKey": "settings.user.off"
              }
            ],
            "default": "inherit",
            "personal": true
          },
          {
            "key": "enableDrive",
            "type": "select",
            "labelKey": "settings.user.enableDrive.label",
            "descriptionKey": "settings.user.enableDrive.description",
            "group": "settings.host.displayGroup",
            "options": [
              {
                "value": "inherit",
                "labelKey": "settings.user.inherit"
              },
              {
                "value": "on",
                "labelKey": "settings.user.on"
              },
              {
                "value": "off",
                "labelKey": "settings.user.off"
              }
            ],
            "default": "inherit",
            "personal": true
          },
          {
            "key": "disableCopy",
            "type": "select",
            "labelKey": "settings.user.disableCopy.label",
            "descriptionKey": "settings.user.disableCopy.description",
            "group": "settings.host.displayGroup",
            "options": [
              {
                "value": "inherit",
                "labelKey": "settings.user.inherit"
              },
              {
                "value": "on",
                "labelKey": "settings.user.on"
              },
              {
                "value": "off",
                "labelKey": "settings.user.off"
              }
            ],
            "default": "inherit",
            "personal": true
          },
          {
            "key": "disablePaste",
            "type": "select",
            "labelKey": "settings.user.disablePaste.label",
            "descriptionKey": "settings.user.disablePaste.description",
            "group": "settings.host.displayGroup",
            "options": [
              {
                "value": "inherit",
                "labelKey": "settings.user.inherit"
              },
              {
                "value": "on",
                "labelKey": "settings.user.on"
              },
              {
                "value": "off",
                "labelKey": "settings.user.off"
              }
            ],
            "default": "inherit",
            "personal": true
          }
        ]
      }
    },
    "uses": ["session.remoteDisplay", "wakeOnLan.macAddress"]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
