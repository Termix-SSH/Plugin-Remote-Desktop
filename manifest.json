        "name": "monitor",
        "titleKey": "permissions.monitor.title",
        "descriptionKey": "permissions.monitor.description",
        "defaultRoles": ["admin"]
      },
      {
        "name": "moonlight",
        "titleKey": "permissions.moonlight.title",
        "descriptionKey": "permissions.moonlight.description",
        "defaultRoles": ["admin"]
      }
    ],
    "settings": {
